{
  "expo": {
    "name": "HanziCramming",
    "slug": "hanzicramming",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hanzicramming",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {"supportsTablet": true},
    "android": {"package": "com.md24ru.hanzicramming", "edgeToEdgeEnabled": true},
    "web": {"bundler": "metro", "output": "static"},
    "plugins": ["expo-router", "expo-web-browser"],
    "experiments": {"typedRoutes": true},
    "extra": {"router": {}}
  }
}