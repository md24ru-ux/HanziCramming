{
  "expo": {
    "name": "HanziCramming2",
    "slug": "hanzicramming2",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hanzicramming2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./HanziCramming.png",
    "ios": {"supportsTablet": true},
    "android": {
      "package": "com.md24ru.hanzicramming2",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./HanziCramming.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {"bundler": "metro", "output": "static"},
    "plugins": ["expo-router", "expo-web-browser"],
    "experiments": {"typedRoutes": true},
    "extra": {"router": {}},
    "owner": "md24ru"
  }
}
